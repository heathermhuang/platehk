{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "platehk",
  "main": "cloudflare-worker/src/index.mjs",
  "compatibility_date": "2026-03-24",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "plate.hk/*",
      "zone_name": "plate.hk"
    },
    {
      "pattern": "www.plate.hk/*",
      "zone_name": "plate.hk"
    },
    {
      "pattern": "pvrm.hk/*",
      "zone_name": "pvrm.hk"
    }
  ],
  "assets": {
    "directory": ".tmp/cloudflare-public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "AGENT_REGISTRATIONS", "class_name": "AgentRegistrationStore" }]
  },
  "migrations": [{ "tag": "agent-registration-v1", "new_sqlite_classes": ["AgentRegistrationStore"] }],
  "vars": {
    "VISION_PROVIDER": "workers_ai",
    "CLOUDFLARE_VISION_MODEL": "@cf/qwen/qwen3.8-27b",
    "APP_ENV": "production",
    "OPENAI_BASE_URL": "https://api.openai.com/v1",
    "OPENAI_VISION_MODEL": "gpt-4.1-mini",
    "OPENAI_TIMEOUT_SECONDS": "20",
    "CONTACT_UNLOCK_ENABLED": "true",
    "CONTACT_UNLOCK_PRICE_ID": "price_1UPrhCRbZoeMqjs2ADiuEoMy",
    "INTRODUCTION_SERVICE_URL": "",
    "INTRODUCTION_WHATSAPP_NUMBER": ""
  },
  "secrets": {
    "required": [
      "APP_SECURITY_TOKEN_SECRET"
    ]
  }
}
